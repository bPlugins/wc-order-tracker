{
	"name": "bplugins/wc-order-tracker",
	"description": "Order Tracker for WooCommerce – Track Customer Order",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"platform": {
			"php": "8.0.30"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	}
}
